APP_NAME=Camplo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=camplo
DB_USERNAME=postgres
DB_PASSWORD=
# Or one connection string (Render, Railway, Neon…):
# DATABASE_URL=postgresql://user:pass@host:5432/camplo

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------- Camplo
# Same variable names as the Node version, so an existing deployment's settings carry over.
# Production needs ENCRYPTION_KEY (64 hex chars, or base64 of 32 bytes) and JWT_SECRET.
ENCRYPTION_KEY=
JWT_SECRET=
AUTO_ACTIVATE=true
ALLOW_DIRECT_PLAN_CHANGE=false
SEED_DEMO=true
SUPPORT_EMAIL=support@camplo.app
# Email: SMTP_* or RESEND_API_KEY (otherwise emails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Camplo <no-reply@camplo.app>"
RESEND_API_KEY=
# AI (optional): platform-paid models via OpenRouter; workspaces can also bring their own key
OPENROUTER_API_KEY=
# Long-term memory (optional): a Hindsight server; without it Camplo uses relational memory
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=
# Payments (optional)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Super Admin console at /admin (optional)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
